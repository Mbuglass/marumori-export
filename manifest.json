{
  "manifest_version": 3,
  "name": "MaruMori Export",
  "version": "1.0.0",
  "description": "Export your MaruMori vocabulary and kanji for use in other language learning tools",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://public-api.marumori.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MaruMori Export"
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
